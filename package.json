{
  "name": "ixaeon",
  "private": true,
  "version": "0.2.1",
  "description": "IXAEON（析衍）— 本地项目记忆与编码 AI 背景服务",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css,html}\" \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"apps/*/scripts/**/*.mjs\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css,html}\" \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"apps/*/scripts/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:unit": "node node_modules/vitest/vitest.mjs run --project unit",
    "test:integration": "node node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "package:windows": "node scripts/package-windows.mjs",
    "setup:browsers": "node apps/desktop/node_modules/playwright/cli.js install chromium"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
