{
  "roles": {
    "integrator": {
      "argv": [
        "claude",
        "--restricted",
        "--tools",
        "PowerShell Write Edit Read",
        "--allowedTools",
        "Write Edit PowerShell(git:*) PowerShell(node:*) PowerShell(corepack:*) PowerShell(gh:*)",
        "--permission-prompts",
        "none",
        "--output-format",
        "json",
        "--add-dir",
        "<数据目录>/turns",
        "-p",
        "读 {prompt_file}，照里面做。"
      ],
      "cwd": "<整合方工作目录>",
      "timeoutMinutes": 90,
      "quotaPatterns": ["usage_limit_reached", "session limit"],
      "quotaPauseMinutes": 120
    },
    "developer": {
      "argv": [
        "claude",
        "--restricted",
        "--tools",
        "PowerShell Write Edit Read",
        "--allowedTools",
        "Write Edit PowerShell(git:*) PowerShell(node:*) PowerShell(corepack:*) PowerShell(gh:*)",
        "--permission-prompts",
        "none",
        "--output-format",
        "json",
        "--add-dir",
        "<数据目录>/turns",
        "-p",
        "读 {prompt_file}，照里面做。"
      ],
      "cwd": "<开发 agent 的操作目录>",
      "timeoutMinutes": 180,
      "quotaPatterns": ["usage_limit_reached", "session limit"],
      "quotaPauseMinutes": 200
    }
  },
  "idleSeconds": 60,
  "localUserCheck": ["node", "scripts/check-local-user.mjs"],
  "_备选_dsh": "DSH 的凭据用户已经打开（2026-10-22）。dsh.cmd 是批处理、调度器不经 shell 起不了，要一个直接起 DeepSeek Harness.exe 并带 ELECTRON_RUN_AS_NODE=1 的小启动器（照 scripts/real/l2-dsh-turn.mjs），接进正式配置是下一单的事"
}
