# Dependencies
node_modules/

# Build outputs
dist/
out/
release/
build/release/
*.tsbuildinfo

# Test artifacts
coverage/
playwright-report/
.playwright-out/
test-results/
.temp/
tmp/

# Runtime data (IXAEON never writes into the repo, but ignore just in case)
ixaeon.db
*.db-shm
*.db-wal
vault/
logs/
backups/

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS junk
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# 复审套件（Playwright）的运行产物：每次运行都会重写，不进版本管理
apps/desktop/test/review/.*-verify/

# 审核脚本的本地证据目录（scripts/real/global-audit-*.mjs 写这里）
.audit-global-*/
