{
  "manifest_version": 3,
  "name": "IXAEON 析衍采集助手",
  "version": "0.2.5",
  "description": "把 chatgpt.com 当前对话中可见的消息增量送入本机 IXAEON（需先在 IXAEON 桌面应用中配对）。不读取 Cookie、历史或其他网站。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "IXAEON 采集助手",
    "default_popup": "popup.html"
  }
}
